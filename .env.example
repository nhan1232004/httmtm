# ShopVN Environment Variables Template
# Copy this file to .env and fill in your actual values

# Gmail SMTP Configuration (for OTP emails)
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Database Configuration
DATABASE_URL=sqlite:///./backend/data/shop.db

# API Configuration
API_PORT=8000
API_HOST=0.0.0.0
API_RELOAD=true

# Frontend Configuration
SELLER_PORT=3001
BUYER_PORT=3002
VITE_API_URL=http://localhost:8000

# Security
SECRET_KEY=your-secret-key-here-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# Environment
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Optional: Cloud Services
# AWS_ACCESS_KEY=
# AWS_SECRET_KEY=
# STRIPE_API_KEY=
# SENDGRID_API_KEY=
